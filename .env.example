# ===== Copy this file to ".env" and fill in your values =====

# --- Server
PORT=5001
NODE_ENV=production
# Websites + admin panel allowed to call the API (comma separated, no trailing slash)
CLIENT_URL=https://youthforhumanrightsindia.org,https://www.holyvisioninternational.org,https://admin.example.com
# 1 when running behind Render / Nginx / Cloudflare
TRUST_PROXY=1

# --- Database
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/holyvision

# --- Login tokens (use a long random text)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d
# Optional: lets /api/auth/registerUser create an Admin when the body has "setupKey"
ADMIN_SETUP_KEY=

# --- Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=holyvision
MAX_UPLOAD_MB=10
# local = keep uploads on this server in ./uploads (automatic when Cloudinary keys are empty)
UPLOAD_DRIVER=
# public address of this API, used for local upload links (e.g. https://api.example.com)
PUBLIC_URL=

# --- Membership
# Fees per category (the website shows the QR for categories with a fee)
MEMBER_FEES={"Student Membership":0,"Organizational Membership":1000,"Corporate Membership":5000}
# How long a membership stays valid after the admin approves it
MEMBERSHIP_VALIDITY_MONTHS=12

# --- OTP
# console (prints OTP in the server log) or whatsapp
OTP_CHANNEL=console
OTP_EXPIRY_MINUTES=5
WHATSAPP_OTP_URL=http://wa.techrush.in/api/http-authkey.php
WHATSAPP_AUTHKEY=
WHATSAPP_ROUTE=2
# Only for local testing: returns the OTP in the API response (never in production)
OTP_DEBUG=false
# Optional fixed OTP for a demo/review number
TEST_PHONE=
TEST_OTP=

# --- Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Holy Vision International

# --- Razorpay (optional, not used by the websites yet)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# --- Spam protection (requests per window, per IP)
FORM_RATE_WINDOW_MIN=15
FORM_RATE_MAX=30
AUTH_RATE_WINDOW_MIN=15
AUTH_RATE_MAX=20
LOOKUP_RATE_WINDOW_MIN=15
LOOKUP_RATE_MAX=60
MAX_PAGE_LIMIT=100
